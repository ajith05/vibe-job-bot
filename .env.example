# Discord Bot Configuration
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_CHANNEL_ID=your_channel_id_here

# OpenAI API Configuration
OPENAI_API_KEY=your_openai_api_key_here

# Job Crawler Configuration
# How often to check for new jobs (in seconds)
CHECK_INTERVAL=3600

# Job search keywords (comma-separated)
JOB_KEYWORDS=python developer,software engineer,backend developer

# Maximum number of jobs to fetch per check
MAX_JOBS_PER_CHECK=5
